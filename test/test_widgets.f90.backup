    integer :: i
    
    test_checked = .false.
    
    ! Memory efficiency test - create and destroy many checkboxes
    do i = 1, 200
        write(test_id, '("memory_checkbox_", I0)') i
        call mock_checkbox(test_id, test_checked)
    end do
    
    ! Reset to free memory
