    call mock_checkbox(test_id, test_checked)
    
    ! Simulate another click - should toggle back to false  
    call simulate_checkbox_click(test_id, 10.0, 10.0)
    call mock_checkbox(test_id, test_checked)
    
    print *, "  ✓ mouse click toggle: state changes validated"
