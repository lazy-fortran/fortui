    logical :: test_checked
    character(len=32) :: test_id = "test_render_checkbox"
    integer :: i
    
    test_checked = .false.
    
    ! TUI rendering performance
    call set_backend_mode("TUI")
    do i = 1, 100
        call mock_checkbox(test_id, test_checked)
    end do
    
    ! GUI rendering performance
    call set_backend_mode("GUI")
    do i = 1, 100
        call mock_checkbox(test_id, test_checked)
    end do
    
    print *, "  ✓ rendering performance: smooth performance across backends"
end subroutine test_checkbox_rendering_performance

! =========================================================================================
! CHECKBOX MOCK FUNCTIONS AND TESTING UTILITIES
! =========================================================================================

subroutine mock_checkbox(id, checked)
    ! Mock checkbox implementation for testing
    character(*), intent(in) :: id
    logical, intent(inout) :: checked
    
    ! Call the actual checkbox widget implementation
    block
        logical :: toggled
        toggled = checkbox(id, checked)
    end block
end subroutine mock_checkbox

subroutine mock_checkbox_with_label(id, checked, label)
    ! Call real checkbox with label implementation for testing
    character(*), intent(in) :: id, label
    logical, intent(inout) :: checked
    
    ! Call the actual checkbox widget with label
    block
        logical :: toggled
        toggled = checkbox(id, checked, label=label)
    end block
end subroutine mock_checkbox_with_label

subroutine mock_checkbox_with_dimensions(id, checked, width, height)
    ! Call real checkbox with dimensions implementation for testing
    character(*), intent(in) :: id
    logical, intent(inout) :: checked
    class(*), intent(in) :: width, height
    
    type(ui_context) :: ctx
    real :: width_dp, height_dp
    
    ! Get context for unit conversion
    call ui_get_context_from_units(ctx)
    
    ! Convert units to dp
    width_dp = convert_to_dp(width, ctx)
    height_dp = convert_to_dp(height, ctx)
    
    ! Call the actual checkbox widget with dimensions
    block
        logical :: toggled
        toggled = checkbox(id, checked, width=width_dp, height=height_dp)
    end block
end subroutine mock_checkbox_with_dimensions

subroutine mock_checkbox_full(id, checked, label, width, height)
    ! Call real checkbox with all parameters implementation for testing
    character(*), intent(in) :: id, label
    logical, intent(inout) :: checked
    class(*), intent(in) :: width, height
    
    type(ui_context) :: ctx
    real :: width_dp, height_dp
    
    ! Get context for unit conversion
    call ui_get_context_from_units(ctx)
    
    ! Convert units to dp
    width_dp = convert_to_dp(width, ctx)
    height_dp = convert_to_dp(height, ctx)
    
    ! Call the actual checkbox widget with all parameters
    block
        logical :: toggled
        toggled = checkbox(id, checked, label=label, width=width_dp, height=height_dp)
    end block
end subroutine mock_checkbox_full

